# GCS Server Configuration

# Vercel Persistence (Hacker Fix: GitHub Sync)
# -------------------------------------------
# Instructions:
# 1. Go to GitHub -> Settings -> Developer Settings -> Personal access tokens (classic)
# 2. Generate a token with "repo" scope.
# 3. Copy/Paste the token below.
# 4. For GITHUB_REPO, use "username/repo-name" format.

GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_username/your_repo_name
GITHUB_BRANCH=main

# Security
# --------
JWT_SECRET=a_long_random_secret_keep_it_safe

# Local Dev
# ---------
PORT=3001
