# GCS Server Configuration

# MongoDB
# -------
# Use the same values in Vercel Project Settings -> Environment Variables.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=GCS
MONGODB_DB=gcs

# Security
# --------
JWT_SECRET=a_long_random_secret_keep_it_safe

# Default Owner Initial Credentials (Used for initial database seed)
# -----------------------------------------------------------------
DEFAULT_OWNER_EMAIL=owner@example.com
DEFAULT_OWNER_PASSWORD=YourSecureOwnerPassword123!
DEFAULT_OWNER_CODENAME=QuickSilver

# Local Dev
# ---------
PORT=3001
